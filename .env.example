# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=production
# Which client profile (folder in clients/) this install runs for.
CLIENT=sample
# Public URL customers use (goes into WhatsApp tracking links).
PUBLIC_BASE_URL=https://order.example.com
DB_PATH=./data/ordering.db

# Encrypts keys saved in Head office → Connections. Set once, never change: openssl rand -hex 32
SETTINGS_KEY=

# Head office panel (/admin/) login. 24+ random characters: openssl rand -hex 24
ADMIN_TOKEN=

# WhatsApp Cloud API (Meta Business > WhatsApp > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string; enter the same value in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify webhook signatures.
WHATSAPP_APP_SECRET=

# In-chat UPI payments on WhatsApp ("Review and pay"; India). Set each outlet's
# payment configuration name (from WhatsApp Manager > Payments) in outlets.wa_payment_config.
WHATSAPP_PAYMENTS=off
WHATSAPP_PAYMENTS_GOODS_TYPE=digital-goods

# Shadowfax Hyperlocal (delivery riders). Leave the token empty to turn it off,
# or set SHADOWFAX_MODE=simulate to try it locally with a pretend Shadowfax.
SHADOWFAX_TOKEN=
SHADOWFAX_BASE_URL=https://hlbackend.staging.shadowfax.in
# Shared secret Shadowfax sends in the X-Callback-Token header on callbacks.
SHADOWFAX_CALLBACK_TOKEN=
# Book the rider when the outlet accepts (accepted) or starts cooking (preparing).
# Applies to every delivery partner.
SHADOWFAX_BOOK_ON=accepted

# More delivery partners. Each one is used when its key is set; every order is
# quoted by all of them and the best price + rider wait wins (src/delivery/selector.js).
# Porter: two-wheelers, prepaid orders only. Keys via porter.in/api-integrations.
PORTER_API_KEY=
PORTER_BASE_URL=https://pfe-apigw-uat.porter.in
# Add ?token=<this> to the webhook URL you give Porter: https://<domain>/webhooks/porter?token=...
PORTER_CALLBACK_TOKEN=
# Borzo: motorbike couriers, cash on delivery supported. Self-serve test account.
BORZO_TOKEN=
BORZO_BASE_URL=https://robotapitest-in.borzodelivery.com/api/business/1.8
# "Callback Secret Key" from the Borzo dashboard; callback URL https://<domain>/webhooks/borzo
BORZO_CALLBACK_SECRET=
# A minute of waiting for a rider is worth this much when comparing partners (paise).
DELIVERY_MINUTE_VALUE_PAISE=300
# No rider after this many minutes: cancel and book the next partner.
DELIVERY_REASSIGN_MINUTES=8

# Reviews: ask for star ratings on WhatsApp this many minutes after delivery.
REVIEW_DELAY_MINUTES=30
# Approved WhatsApp template used to ask web customers (optional; see README).
WHATSAPP_REVIEW_TEMPLATE=
WHATSAPP_REVIEW_TEMPLATE_LANG=en

# Optional copy of all data in Supabase (Project Settings > API). The service
# role key is secret: server only, never in the browser. See DEPLOY.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dynamic UPI QR (default "Pay now"): every order gets a QR / UPI link with the
# exact amount, prefilled, and the order code as the transaction reference.
# UPI_ID: the merchant UPI ID from your payment gateway, used by every outlet
# (an outlet's own UPI ID in Head office → Outlets overrides it).
UPI_ID=
# Name shown in the customer's UPI app (default: the brand name).
UPI_PAYEE_NAME=
# Merchant category code for merchant UPI IDs: 5812 = restaurants. Empty for a personal UPI ID.
UPI_MERCHANT_CODE=5812

# Razorpay payment gateway (optional, recommended). With these, "Pay now" uses a
# Razorpay payment link (UPI apps, QR, cards) that confirms itself through the
# webhook https://<domain>/webhooks/razorpay (event payment_link.paid), and paid
# orders the outlet cancels are refunded. Without them, UPI goes straight to each
# outlet's UPI ID and staff confirm payments by hand. See DEPLOY.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PhonePe Payment Gateway (alternative to Razorpay; set one of the two). Gives
# every order PhonePe's own dynamic UPI QR and a pay page; PhonePe calls
# https://<domain>/webhooks/phonepe and our server also checks open payments
# every 30 s. PHONEPE_ENV=sandbox works with PhonePe's shared test merchant
# (PGTESTPAYUAT86); use production with your own merchant ID and salt key.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

# "Pay now (UPI)" orders wait this many minutes for payment before they are cancelled.
PAYMENT_WINDOW_MINUTES=15

# Loyalty: 1 point for every this many rupees of a completed order.
LOYALTY_RUPEES_PER_POINT=100

# Delivery range (road km from the nearest open outlet). Choose it so the
# outlets' ranges overlap and leave no gaps between them.
MAX_DELIVERY_KM=20
# Shadowfax rate card shown to and charged to customers (paise): base fare for
# the first DELIVERY_BASE_KM, then per extra km. Use your contract rates.
DELIVERY_BASE_KM=3
DELIVERY_BASE_FEE_PAISE=4000
DELIVERY_PER_KM_PAISE=1000
# Make delivery free (outlet pays Shadowfax) above this item total; 0 = off.
FREE_DELIVERY_ABOVE_PAISE=0

# Optional pricing overrides (paise)
# PACKING_CHARGE_PAISE=1000
# MIN_DELIVERY_ORDER_PAISE=14900
